#tag EndWebPage

#tag WindowCode
	#tag Event
		Sub Shown()
		  lstDates.HeaderAt(0) = "Entry date"
		  LoadEntries
		  ClearForm
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h21
		Private Sub ClearForm()
		  CurrentID = 0
		  pickDate.SelectedDate = DateTime.Now
		  txtChanges.Text = ""
		  lstDates.SelectedRowIndex = -1
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub HandleDeleteConfirm(dialog As WebMessageDialog, button As WebMessageDialogButton)
		  #Pragma Unused dialog
		  If button.Caption <> "Delete" Then Return
		  If CurrentID <= 0 Then Return
		  
		  Try
		    Var sql As String = "DELETE FROM changelog WHERE id = ?"
		    Var ps As PreparedSQLStatement = Session.DB.Prepare(sql)
		    ps.BindType(0, MySQLPreparedStatement.MYSQL_TYPE_LONG)
		    ps.Bind(0, CurrentID)
		    ps.ExecuteSQL
		    Session.FlashCaption("Deleted", btnDeleteEntry, 1500)
		    LoadEntries
		    ClearForm
		  Catch err As DatabaseException
		    MessageBox("Error deleting entry: " + err.Message)
		  End Try
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub LoadEntries()
		  lstDates.RemoveAllRows
		  Try
		    Var rs As RowSet = Session.DB.SelectSQL("SELECT id, entry_date FROM changelog ORDER BY entry_date DESC, id DESC")
		    While Not rs.AfterLastRow
		      Var dt As DateTime = rs.Column("entry_date").DateTimeValue
		      lstDates.AddRow(dt.SQLDate)
		      lstDates.RowTagAt(lstDates.LastAddedRowIndex) = rs.Column("id").IntegerValue
		      rs.MoveToNextRow
		    Wend
		  Catch err As DatabaseException
		    MessageBox("Error loading changelog: " + err.Message)
		  End Try
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub LoadEntry(id As Integer)
		  Try
		    Var sql As String = "SELECT entry_date, body FROM changelog WHERE id = ?"
		    Var ps As PreparedSQLStatement = Session.DB.Prepare(sql)
		    ps.BindType(0, MySQLPreparedStatement.MYSQL_TYPE_LONG)
		    ps.Bind(0, id)
		    Var rs As RowSet = ps.SelectSQL
		    If Not rs.AfterLastRow Then
		      CurrentID = id
		      Var dt As DateTime = rs.Column("entry_date").DateTimeValue
		      pickDate.SelectedDate = dt
		      txtChanges.Text = rs.Column("body").StringValue
		    End If
		  Catch err As DatabaseException
		    MessageBox("Error loading entry: " + err.Message)
		  End Try
		End Sub
	#tag EndMethod


	#tag Property, Flags = &h21
		Private CurrentID As Integer = 0
	#tag EndProperty


#tag EndWindowCode

#tag Events lstDates
	#tag Event
		Sub SelectionChanged(rows() As Integer)
		  #Pragma Unused rows
		  If me.SelectedRowIndex >= 0 Then
		    LoadEntry(me.RowTagAt(me.SelectedRowIndex))
		  End If
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Button1
	#tag Event
		Sub Pressed()
		  // Close
		  Self.Close
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnSave
	#tag Event
		Sub Pressed()
		  // Save
		  Var entryDate As DateTime = pickDate.SelectedDate
		  Var bodyText As String = txtChanges.Text.Trim
		  
		  If entryDate = Nil Then
		    MessageBox("Please pick a date")
		    Return
		  End If
		  If bodyText = "" Then
		    MessageBox("Please enter the change body")
		    Return
		  End If
		  
		  Try
		    If CurrentID = 0 Then
		      Var sql As String = "INSERT INTO changelog (entry_date, body, created_by) VALUES (?, ?, ?)"
		      Var ps As PreparedSQLStatement = Session.DB.Prepare(sql)
		      ps.BindType(0, MySQLPreparedStatement.MYSQL_TYPE_DATE)
		      ps.BindType(1, MySQLPreparedStatement.MYSQL_TYPE_STRING)
		      ps.BindType(2, MySQLPreparedStatement.MYSQL_TYPE_STRING)
		      ps.Bind(0, entryDate.SQLDate)
		      ps.Bind(1, bodyText)
		      ps.Bind(2, Session.CurrentUsername)
		      ps.ExecuteSQL
		      Var idrs As RowSet = Session.DB.SelectSQL("SELECT LAST_INSERT_ID() AS id")
		      If Not idrs.AfterLastRow Then CurrentID = idrs.Column("id").IntegerValue
		    Else
		      Var sql As String = "UPDATE changelog SET entry_date = ?, body = ? WHERE id = ?"
		      Var ps As PreparedSQLStatement = Session.DB.Prepare(sql)
		      ps.BindType(0, MySQLPreparedStatement.MYSQL_TYPE_DATE)
		      ps.BindType(1, MySQLPreparedStatement.MYSQL_TYPE_STRING)
		      ps.BindType(2, MySQLPreparedStatement.MYSQL_TYPE_LONG)
		      ps.Bind(0, entryDate.SQLDate)
		      ps.Bind(1, bodyText)
		      ps.Bind(2, CurrentID)
		      ps.ExecuteSQL
		    End If
		    
		    Session.FlashCaption("Saved", Me, 1500)
		    LoadEntries
		    
		    // Reselect the row we just saved
		    For i As Integer = 0 To lstDates.LastRowIndex
		      If lstDates.RowTagAt(i) = CurrentID Then
		        lstDates.SelectedRowIndex = i
		        Exit
		      End If
		    Next
		    
		  Catch err As DatabaseException
		    MessageBox("Error saving entry: " + err.Message)
		  End Try
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnNewEntry
	#tag Event
		Sub Pressed()
		  // New entry
		  ClearForm
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnDeleteEntry
	#tag Event
		Sub Pressed()
		  // Delete entry
		  If CurrentID <= 0 Then
		    MessageBox("Select an entry to delete first")
		    Return
		  End If
		  
		  Var dlg As New WebMessageDialog
		  dlg.Message = "Delete this changelog entry?"
		  dlg.Explanation = "This cannot be undone."
		  dlg.ActionButton.Caption = "Delete"
		  dlg.ActionButton.Indicator = WebUIControl.Indicators.Danger
		  dlg.CancelButton.Caption = "Cancel"
		  dlg.CancelButton.Visible = True
		  AddHandler dlg.ButtonPressed, AddressOf HandleDeleteConfirm
		  dlg.Show
		End Sub
	#tag EndEvent
#tag EndEvents
